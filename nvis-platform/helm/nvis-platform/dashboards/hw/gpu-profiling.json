{
  "title": "${dgx_flavor} - GPU Profiling",
  "uid": "nvis-hwval-gpu-profiling",
  "description": "Historical timeseries of every DGX temperature/fan/power sensor for correlating with random-shutdown events. Line charts show spikes; logs panels show SEL + SOL.",
  "tags": [
    "nvis",
    "redfish",
    "gpu",
    "temperature",
    "spike",
    "sel",
    "sol",
    "hwval"
  ],
  "schemaVersion": 38,
  "style": "dark",
  "timezone": "browser",
  "refresh": "60s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "nvis-prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "__CLUSTER_NAME__",
            "value": "__CLUSTER_NAME__"
          }
        ],
        "hide": 0,
        "allValue": ".*",
        "definition": "label_values(up, cluster)"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(redfish_fast_up, dgx_flavor)",
        "hide": 0,
        "includeAll": true,
        "label": "DGX Flavor",
        "multi": false,
        "name": "dgx_flavor",
        "options": [],
        "query": {
          "query": "label_values(redfish_fast_up, dgx_flavor)",
          "refId": "DgxFlavorQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "allValue": ".*"
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "query": {
          "query": "label_values(redfish_temperature_celsius{cluster=~\"$cluster\"}, bmc)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "power_component",
        "label": "Power Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "query": {
          "query": "label_values(redfish_component_power_watts{cluster=~\"$cluster\"}, component)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search (regex, case-insensitive)",
        "description": "Free-text filter for SEL + SOL log panels. Examples: Thermal Trip | Processor | IERR | S5/G2",
        "current": {
          "text": "",
          "value": "",
          "selected": false
        },
        "query": "",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
