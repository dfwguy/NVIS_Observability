    {
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div id=\"topo-wrap\" style=\"width:100%;height:100%;background:#0d0d1a;color:#e0e0e0;font-family:'Roboto Mono',monospace;overflow:auto;position:relative;\">\n<style>\n#topo-wrap *{box-sizing:border-box}\n#t-hdr{display:flex;align-items:center;gap:12px;padding:8px 12px;background:#111125;border-bottom:1px solid #252545}\n#t-hdr .kpi{background:#161630;border:1px solid #2a2a50;border-radius:6px;padding:4px 14px;text-align:center}\n#t-hdr .kpi .kv{font-size:1.6em;font-weight:700;line-height:1.2}\n#t-hdr .kpi .kl{font-size:.65em;color:#8888aa;text-transform:uppercase;letter-spacing:.06em}\n#t-body{padding:10px 12px}\n.sec-hdr{font-size:.7em;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#6666aa;margin:10px 0 6px;padding-left:2px}\n/* Rack heatmap */\n#rack-grid{display:flex;flex-wrap:wrap;gap:5px}\n.rack{width:130px;height:72px;border-radius:5px;border:1px solid rgba(255,255,255,.1);padding:5px 8px;cursor:pointer;transition:all .15s;position:relative;overflow:hidden}\n.rack:hover{transform:scale(1.04);z-index:2;border-color:rgba(255,255,255,.4)}\n.rack .rn{font-size:.7em;font-weight:700;color:rgba(255,255,255,.85)}\n.rack .ru{font-size:1.5em;font-weight:700;margin-top:2px}\n.rack .rm{font-size:.6em;color:rgba(255,255,255,.55);margin-top:1px}\n.rack .ri{position:absolute;bottom:4px;right:6px;font-size:.6em;color:rgba(255,255,255,.4)}\n/* Node cards (small cluster) */\n.node-card{display:inline-flex;flex-direction:column;gap:3px;background:#161630;border:1px solid #252545;border-radius:6px;padding:6px 10px;min-width:140px;cursor:pointer;transition:border-color .15s}\n.node-card:hover{border-color:#5555aa}\n.node-card .nc-title{font-size:.75em;font-weight:700;white-space:nowrap}\n.node-card .nc-row{display:flex;justify-content:space-between;font-size:.62em;color:#9999bb}\n/* Infra row */\n.infra-row{display:flex;gap:8px;flex-wrap:wrap}\n.infra-card{background:#1a1a35;border:1px solid #303068;border-radius:6px;padding:6px 14px;min-width:160px}\n.infra-card .it{font-size:.65em;color:#7777aa;text-transform:uppercase}\n.infra-card .iv{font-size:.95em;font-weight:600;margin-top:2px}\n/* RunAI project row */\n#runai-row{display:flex;gap:6px;flex-wrap:wrap}\n.rp{background:#0f1f2a;border:1px solid #1a3a4a;border-radius:5px;padding:4px 10px;font-size:.65em}\n.rp .rpn{color:#33ccff;font-weight:700}\n.rp .rpv{color:#aaddff}\n/* Top nodes */\n#hot-list{display:flex;flex-wrap:wrap;gap:5px}\n.hn{background:#1a1a1a;border:1px solid #333;border-radius:4px;padding:3px 8px;font-size:.65em;display:flex;gap:6px;align-items:center}\n/* Status dot */\n.dot{width:7px;height:7px;border-radius:50%;display:inline-block}\n/* Drill panel */\n#drill{display:none;position:fixed;top:60px;right:20px;width:260px;background:#13132a;border:1px solid #333366;border-radius:8px;padding:12px;z-index:100;max-height:80vh;overflow-y:auto}\n#drill h3{font-size:.8em;margin:0 0 8px;color:#aaaaff}\n#drill .dc{font-size:.65em;line-height:1.8;color:#ccccdd}\n#drill-close{float:right;cursor:pointer;color:#666;font-size:.8em}\n</style>\n\n<div id=\"t-hdr\">\n  <div style=\"font-size:.8em;font-weight:700;color:#aaaaff;min-width:80px\">NVIS<br><span style=\"color:#6666aa;font-size:.8em\">LIVE TOPOLOGY</span></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-nodes\">—</div><div class=\"kl\">GPU Nodes</div></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-gpus\">—</div><div class=\"kl\">Total GPUs</div></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-util\" style=\"color:#44ff88\">—</div><div class=\"kl\">Avg Util</div></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-pow\">—</div><div class=\"kl\">Total kW</div></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-err\" style=\"color:#ff6644\">—</div><div class=\"kl\">XID Errors</div></div>\n  <div class=\"kpi\"><div class=\"kv\" id=\"k-wl\">—</div><div class=\"kl\">RunAI WL</div></div>\n  <div style=\"margin-left:auto;font-size:.6em;color:#555577\" id=\"ts\">—</div>\n</div>\n\n<div id=\"t-body\">\n  <div id=\"s-infra\">\n    <div class=\"sec-hdr\">&#11035; Infrastructure</div>\n    <div class=\"infra-row\" id=\"infra-cards\"></div>\n  </div>\n\n  <div id=\"s-gpu\" style=\"margin-top:8px\">\n    <div class=\"sec-hdr\" id=\"gpu-sec-hdr\">&#128995; GPU Nodes</div>\n    <div id=\"rack-grid\"></div>\n    <div id=\"node-grid\" style=\"display:flex;flex-wrap:wrap;gap:6px\"></div>\n  </div>\n\n  <div id=\"s-hot\" style=\"margin-top:8px\">\n    <div class=\"sec-hdr\">&#128293; Top 10 Hottest Nodes</div>\n    <div id=\"hot-list\"></div>\n  </div>\n\n  <div id=\"s-runai\" style=\"margin-top:8px\">\n    <div class=\"sec-hdr\">&#128994; RunAI — Active Workloads</div>\n    <div id=\"runai-row\"></div>\n  </div>\n</div>\n\n<div id=\"drill\">\n  <span id=\"drill-close\" onclick=\"document.getElementById('drill').style.display='none'\">&#x2715; close</span>\n  <h3 id=\"drill-title\"></h3>\n  <div id=\"drill-body\" class=\"dc\"></div>\n</div>\n\n<script>\nvar CLUSTER = '$cluster';\nvar DS_UID  = '${datasource}';\nvar PROM    = '/api/datasources/proxy/uid/' + DS_UID + '/api/v1/query';\n\nfunction esc(s){return String(s).replace(/[<>&\"]/g,function(c){return{'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;'}[c]})}\nfunction fmt(v,d){d=d===undefined?1:d;v=parseFloat(v)||0;return v>=1e9?(v/1e9).toFixed(1)+'G':v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(1)+'K':v.toFixed(d)}\nfunction fmtP(v){return (parseFloat(v)||0).toFixed(1)+'%'}\nfunction utilColor(u){u=parseFloat(u)||0;if(u>=85)return'#ff3333';if(u>=60)return'#ffaa00';if(u>=20)return'#44ff88';return'#3366ff'}\nfunction utilBg(u){u=parseFloat(u)||0;if(u>=85)return'rgba(180,20,20,.25)';if(u>=60)return'rgba(160,100,0,.25)';if(u>=20)return'rgba(20,120,50,.2)';return'rgba(20,40,120,.2)'}\n\nfunction rackFromNode(n){\n  var m = n.match(/gpunode(\\d+)/i);\n  if(!m) return null;\n  return Math.floor((parseInt(m[1])-1)/100);\n}\n\nfunction pq(qs){\n  var url = PROM + '?query=' + encodeURIComponent(qs);\n  return fetch(url, {headers:{'Accept':'application/json'}})\n    .then(function(r){return r.json()})\n    .then(function(d){return (d.data||{}).result||[]})\n    .catch(function(){return []});\n}\n\nasync function refresh(){\n  document.getElementById('ts').textContent = 'Refreshing…';\n  try {\n    var results = await Promise.all([\n      pq('avg by(node)(DCGM_FI_DEV_GPU_UTIL{cluster=~\"'+CLUSTER+'\"})'),\n      pq('sum by(node)(DCGM_FI_DEV_POWER_USAGE{cluster=~\"'+CLUSTER+'\"})'),\n      pq('count by(node)(DCGM_FI_DEV_GPU_UTIL{cluster=~\"'+CLUSTER+'\"})'),\n      pq('sum(DCGM_EXP_XID_ERRORS_COUNT{cluster=~\"'+CLUSTER+'\"}>0)'),\n      pq('max by(bcm_instance)(bcm_managed_nodes_total{cluster=~\"'+CLUSTER+'\"})'),\n      pq('count by(project)(runai_workload_info_enriched{cluster_id=~\"'+CLUSTER+'\"})'),\n      pq('topk(10,avg by(node)(DCGM_FI_DEV_GPU_UTIL{cluster=~\"'+CLUSTER+'\"}))'),\n    ]);\n\n    var nodeUtilRes=results[0], nodePowRes=results[1], gpuCountRes=results[2];\n    var xidRes=results[3], bcmRes=results[4], wlRes=results[5], topRes=results[6];\n\n    // ── Build node map ──────────────────────────────────────────────────────\n    var nodeMap = {};\n    nodeUtilRes.forEach(function(r){ nodeMap[r.metric.node] = {util:parseFloat(r.value[1])||0, pow:0, gpus:0}; });\n    nodePowRes.forEach(function(r){ if(nodeMap[r.metric.node]) nodeMap[r.metric.node].pow = parseFloat(r.value[1])||0; });\n    gpuCountRes.forEach(function(r){ if(nodeMap[r.metric.node]) nodeMap[r.metric.node].gpus = parseInt(r.value[1])||0; });\n\n    var allNodes = Object.keys(nodeMap);\n    var nNodes   = allNodes.length;\n    var nGpus    = Object.values(nodeMap).reduce(function(a,n){return a+n.gpus},0) || nNodes*8;\n    var avgUtil  = nNodes>0 ? Object.values(nodeMap).reduce(function(a,n){return a+n.util},0)/nNodes : 0;\n    var totalKw  = Object.values(nodeMap).reduce(function(a,n){return a+n.pow},0)/1000;\n    var xidCount = parseInt(((xidRes[0]||{value:[0,0]}).value[1]))||0;\n    var wlCount  = wlRes.reduce(function(a,r){return a+parseInt(r.value[1])},0);\n\n    // ── KPIs ────────────────────────────────────────────────────────────────\n    document.getElementById('k-nodes').textContent = nNodes.toLocaleString();\n    document.getElementById('k-gpus').textContent  = nGpus.toLocaleString();\n    document.getElementById('k-util').textContent  = fmtP(avgUtil);\n    document.getElementById('k-util').style.color  = utilColor(avgUtil);\n    document.getElementById('k-pow').textContent   = totalKw.toFixed(1)+'kW';\n    document.getElementById('k-err').textContent   = xidCount > 0 ? xidCount : '0';\n    document.getElementById('k-err').style.color   = xidCount > 0 ? '#ff4444' : '#44ff88';\n    document.getElementById('k-wl').textContent    = wlCount;\n\n    // ── Infra (BCM) ─────────────────────────────────────────────────────────\n    var ic = document.getElementById('infra-cards');\n    ic.innerHTML = '';\n    if(bcmRes.length === 0){\n      ic.innerHTML = '<div class=\"infra-card\"><div class=\"it\">BCM</div><div class=\"iv\">No data</div></div>';\n    } else {\n      bcmRes.forEach(function(r){\n        var nm = r.metric.bcm_instance||'bcm';\n        var tot = parseInt(r.value[1])||0;\n        ic.innerHTML += '<div class=\"infra-card\"><div class=\"it\">BCM — '+esc(nm)+'</div><div class=\"iv\"><span class=\"dot\" style=\"background:#44ff88\"></span> '+tot.toLocaleString()+' nodes managed</div></div>';\n      });\n      ic.innerHTML += '<div class=\"infra-card\"><div class=\"it\">Cluster</div><div class=\"iv\">'+esc(CLUSTER)+'</div></div>';\n    }\n\n    // ── GPU nodes: rack heatmap OR individual cards ─────────────────────────\n    var rg = document.getElementById('rack-grid');\n    var ng = document.getElementById('node-grid');\n    var gh = document.getElementById('gpu-sec-hdr');\n    rg.innerHTML = ''; ng.innerHTML = '';\n\n    if(nNodes > 50){\n      // RACK HEATMAP — scales to thousands of nodes\n      gh.textContent = '&#128995; GPU Nodes — Rack View ('+nNodes.toLocaleString()+' nodes, '+Math.ceil(nNodes/100)+' racks)';\n      ng.style.display = 'none';\n      rg.style.display = 'flex';\n\n      var racks = {};\n      allNodes.forEach(function(n){\n        var ri = rackFromNode(n);\n        if(ri === null) ri = 0;\n        if(!racks[ri]) racks[ri] = {nodes:[], utils:[], pows:[]};\n        racks[ri].nodes.push(n);\n        racks[ri].utils.push(nodeMap[n].util);\n        racks[ri].pows.push(nodeMap[n].pow);\n      });\n\n      Object.keys(racks).sort(function(a,b){return parseInt(a)-parseInt(b)}).forEach(function(ri){\n        var rack = racks[ri];\n        var avgU = rack.utils.reduce(function(a,b){return a+b},0) / rack.utils.length;\n        var totP = rack.pows.reduce(function(a,b){return a+b},0) / 1000;\n        var bg   = utilBg(avgU);\n        var col  = utilColor(avgU);\n        var rack_el = document.createElement('div');\n        rack_el.className = 'rack';\n        rack_el.style.background = bg;\n        rack_el.style.borderColor = col;\n        rack_el.innerHTML =\n          '<div class=\"rn\">Rack '+String(ri).padStart(2,'0')+'</div>'+\n          '<div class=\"ru\" style=\"color:'+col+'\">'+fmtP(avgU)+'</div>'+\n          '<div class=\"rm\">'+rack.nodes.length+' nodes &middot; '+totP.toFixed(1)+'kW</div>'+\n          '<div class=\"ri\">'+(nodeMap[rack.nodes[0]].gpus||8)+' GPU/node</div>';\n        rack_el.onclick = (function(_ri,_rack){\n          return function(){ showRackDrill(_ri,_rack,nodeMap); };\n        })(ri, rack);\n        rg.appendChild(rack_el);\n      });\n\n    } else {\n      // INDIVIDUAL NODE CARDS — small clusters (≤50 nodes)\n      gh.textContent = '&#128995; GPU Nodes ('+nNodes+')';\n      rg.style.display = 'none';\n      ng.style.display = 'flex';\n      allNodes.sort().forEach(function(nm){\n        var nd = nodeMap[nm];\n        var col = utilColor(nd.util);\n        ng.innerHTML +=\n          '<div class=\"node-card\" style=\"border-color:'+col+'\">'+\n          '<div class=\"nc-title\"><span class=\"dot\" style=\"background:'+col+'\"></span> '+esc(nm)+'</div>'+\n          '<div class=\"nc-row\"><span>GPU Util</span><span style=\"color:'+col+'\">'+fmtP(nd.util)+'</span></div>'+\n          '<div class=\"nc-row\"><span>Power</span><span>'+fmt(nd.pow)+'W</span></div>'+\n          '<div class=\"nc-row\"><span>GPUs</span><span>'+(nd.gpus||8)+'</span></div>'+\n          '</div>';\n      });\n    }\n\n    // ── Top 10 hottest ──────────────────────────────────────────────────────\n    var hl = document.getElementById('hot-list');\n    hl.innerHTML = '';\n    topRes.sort(function(a,b){return parseFloat(b.value[1])-parseFloat(a.value[1])}).forEach(function(r,i){\n      var u = parseFloat(r.value[1])||0;\n      var c = utilColor(u);\n      hl.innerHTML += '<div class=\"hn\"><span style=\"color:#666;min-width:14px\">'+(i+1)+'.</span>'+\n        '<span style=\"color:#ddd\">'+esc(r.metric.node)+'</span>'+\n        '<span style=\"color:'+c+';font-weight:700\">'+fmtP(u)+'</span></div>';\n    });\n    if(!topRes.length) hl.innerHTML = '<span style=\"color:#555;font-size:.7em\">No GPU nodes found for cluster: '+esc(CLUSTER)+'</span>';\n\n    // ── RunAI workloads ─────────────────────────────────────────────────────\n    var rr = document.getElementById('runai-row');\n    rr.innerHTML = '';\n    if(wlRes.length === 0){\n      rr.innerHTML = '<span style=\"color:#555;font-size:.7em\">No RunAI workloads</span>';\n    } else {\n      wlRes.sort(function(a,b){return parseInt(b.value[1])-parseInt(a.value[1])}).forEach(function(r){\n        var proj = r.metric.project||'default';\n        rr.innerHTML += '<div class=\"rp\"><span class=\"rpn\">'+esc(proj)+'</span> <span class=\"rpv\">'+r.value[1]+' wl</span></div>';\n      });\n    }\n\n    document.getElementById('ts').textContent = 'Updated ' + new Date().toLocaleTimeString();\n  } catch(e){\n    document.getElementById('ts').textContent = 'Error: ' + e.message;\n  }\n  setTimeout(refresh, 30000);\n}\n\nfunction showRackDrill(ri, rack, nodeMap){\n  document.getElementById('drill-title').textContent = 'Rack '+String(ri).padStart(2,'0')+' — '+rack.nodes.length+' nodes';\n  var sorted = rack.nodes.map(function(n){return {n:n, u:nodeMap[n].util, p:nodeMap[n].pow}})\n                         .sort(function(a,b){return b.u-a.u});\n  var avgU = sorted.reduce(function(a,b){return a+b.u},0)/sorted.length;\n  var totP = sorted.reduce(function(a,b){return a+b.p},0);\n  var html = '<b>Avg util:</b> '+fmtP(avgU)+'<br><b>Total power:</b> '+totP.toFixed(0)+'W<br><br><b>Nodes (by util):</b><br>';\n  sorted.slice(0,20).forEach(function(nd){\n    var c = utilColor(nd.u);\n    html += '<div style=\"display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #222\">'+\n      '<span style=\"color:#ccc\">'+esc(nd.n)+'</span>'+\n      '<span style=\"color:'+c+';font-weight:700\">'+fmtP(nd.u)+'</span></div>';\n  });\n  if(sorted.length > 20) html += '<div style=\"color:#666;font-size:.9em\">... and '+(sorted.length-20)+' more</div>';\n  document.getElementById('drill-body').innerHTML = html;\n  document.getElementById('drill').style.display = 'block';\n}\n\nrefresh();\n</script>\n</div>\n",
        "mode": "html"
      },
      "title": "NVIS Live Topology",
      "type": "text"
    },
