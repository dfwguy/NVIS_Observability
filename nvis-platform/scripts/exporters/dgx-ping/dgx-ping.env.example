# NVIS Platform -- DGX Ping Exporter environment
# Copy to /etc/nvis-platform/dgx-ping.env on the host running the exporter.
#
# DGX_HOSTS: comma-separated `name=ip` pairs, OR `@/path/to/file` for a
# newline-separated list (comments with `#` are allowed in the file form).
DGX_HOSTS=node-1=10.0.0.1,node-2=10.0.0.2

# Static label applied to every emitted series.
CLUSTER_NAME=

# Listen socket.
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=9116

# Polling cadence.
PING_INTERVAL=30
PING_COUNT=5
PING_TIMEOUT=2
