        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(runai_gpu_count_per_cluster{cluster_id=~\"$cluster\"}) or sum(runai_node_gpu_count{cluster_id=~\"$cluster\"}) or vector(0)",
