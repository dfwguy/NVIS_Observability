      "id": 9900,
      "options": {
        "content": "<div style=\"display:flex;align-items:center;height:100%;\"><a href=\"/d/nvis-demo-home\" style=\"display:inline-flex;align-items:center;gap:8px;padding:6px 16px;background:linear-gradient(135deg,#1a1a2e,#16213e);color:#00d4ff;border:1px solid #00d4ff;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;box-shadow:0 0 8px rgba(0,212,255,0.3);\">&#127968; NVIS Home</a></div>",
        "mode": "html"
      },
      "title": "", "transparent": true, "type": "text"
    },
    {
      "gridPos": { "h": 2, "w": 18, "x": 3, "y": 0 },
      "id": 9901,
      "options": {
        "content": "<div style=\"display:flex;align-items:center;height:100%;padding:0 16px;\"><span style=\"font-size:22px;font-weight:700;color:#00d4ff;\">&#128683; Run:AI Self-Monitoring</span><span style=\"margin-left:16px;font-size:13px;color:#aaa;\">Deployment Health \u00b7 Controller Status \u00b7 Scheduling \u00b7 CPU Exhaustion \u00b7 GPU Operator</span></div>",
