{
  "uid": "nvis-netq",
  "title": "${dgx_flavor} NetQ Fabric",
  "tags": ["nvis", "netq", "cumulus", "fabric"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "definition": "label_values(up, cluster)",
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "ClusterQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      },
      {
        "name": "dgx_flavor",
        "type": "query",
        "label": "DGX Flavor",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "definition": "label_values(up, dgx_flavor)",
        "query": {
          "query": "label_values(up, dgx_flavor)",
          "refId": "DgxFlavorQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      },
      {
        "name": "switch",
        "type": "query",
        "label": "Switch",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "definition": "label_values(netq_device_info{cluster=~\"$cluster\"}, hostname)",
        "query": {
          "query": "label_values(netq_device_info{cluster=~\"$cluster\"}, hostname)",
          "refId": "SwitchQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "skipUrlSync": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Switches Up",
      "description": "Number of Cumulus switches NetQ reports as fresh/up.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(netq_device_up{cluster=~\"$cluster\", hostname=~\"$switch\"} == 1)",
          "legendFormat": "Up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Switches Down",
      "description": "Number of Cumulus switches NetQ reports as rotten/down.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(netq_device_up{cluster=~\"$cluster\", hostname=~\"$switch\"} == 0)",
          "legendFormat": "Down",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical Events (1h)",
      "description": "Count of critical-severity events seen by NetQ in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(increase(netq_event_count{cluster=~\"$cluster\", severity=~\"critical|error|crit\"}[1h]))",
          "legendFormat": "Critical",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "NetQ Exporter",
      "description": "Whether the NetQ exporter polled the API without error on the last cycle.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {"text": "UP", "color": "green"},
                "0": {"text": "DOWN", "color": "red"}
              }
            }
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "max(netq_up{cluster=~\"$cluster\"}) or vector(0)",
          "legendFormat": "NetQ",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Device Inventory",
      "description": "All Cumulus switches reported by NetQ, with model, OS version, ASIC and platform.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 4},
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "hostname", "desc": false}]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [{"id": "custom.hidden", "value": true}]
          },
          {
            "matcher": {"id": "byName", "options": "Time"},
            "properties": [{"id": "custom.hidden", "value": true}]
          }
        ]
      },
      "targets": [
        {
          "expr": "netq_device_info{cluster=~\"$cluster\", hostname=~\"$switch\"}",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "hostname": 0,
              "model": 1,
              "version": 2,
              "asic": 3,
              "platform": 4,
              "cluster": 5
            },
            "renameByName": {
              "hostname": "Hostname",
              "model": "Model",
              "version": "OS Version",
              "asic": "ASIC",
              "platform": "Platform",
              "cluster": "Cluster"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Events per Severity (rate, 5m)",
      "description": "Rate of NetQ events grouped by severity.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum by (severity) (rate(netq_event_count{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Link Up Status",
      "description": "Per-link operational state. 1 = up, 0 = down.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "netq_link_up{cluster=~\"$cluster\", src=~\"$switch\"}",
          "legendFormat": "{{src}}:{{src_port}} -> {{dst}}:{{dst_port}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Interface Throughput In (per port)",
      "description": "Per-interface ingress throughput in bits/sec.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(netq_interface_bytes_in{cluster=~\"$cluster\", hostname=~\"$switch\"}[5m]) * 8",
          "legendFormat": "{{hostname}} {{port}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Interface Throughput Out (per port)",
      "description": "Per-interface egress throughput in bits/sec.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(netq_interface_bytes_out{cluster=~\"$cluster\", hostname=~\"$switch\"}[5m]) * 8",
          "legendFormat": "{{hostname}} {{port}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scrape Duration",
      "description": "Time taken for the exporter to complete a full NetQ poll cycle.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 29},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "expr": "netq_scrape_duration_seconds{cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape Errors",
      "description": "Rate of NetQ API endpoint errors per endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 29},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(netq_scrape_errors_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    }
  ]
}
