{
  "title": "${dgx_flavor} - Per-Sensor Temperatures (granular /Sensors endpoint, 80s scrape)",
  "uid": "nvis-hwval-sensors-temps",
  "description": "Per-component temperature dashboard for DGX sourced from the granular /redfish/v1/Chassis/{ch}/Sensors endpoint. Temperatures only — no fan, power, SEL, or SOL panels. Built for David Wise (NVIDIA) to inspect every single temperature sensor.",
  "tags": [
    "temperatures",
    "sensors",
    "hwval"
  ],
  "schemaVersion": 39,
  "style": "dark",
  "timezone": "browser",
  "refresh": "60s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "nvis-prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "__CLUSTER_NAME__",
            "value": "__CLUSTER_NAME__"
          }
        ],
        "hide": 0,
        "allValue": ".*",
        "definition": "label_values(up, cluster)"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(redfish_fast_up, dgx_flavor)",
        "hide": 0,
        "includeAll": true,
        "label": "DGX Flavor",
        "multi": false,
        "name": "dgx_flavor",
        "options": [],
        "query": {
          "query": "label_values(redfish_fast_up, dgx_flavor)",
          "refId": "DgxFlavorQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "allValue": ".*"
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-prometheus"
        },
        "query": {
          "query": "label_values(redfish_sensor_celsius{cluster=~\"$cluster\"}, bmc)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Filter sensor name (regex)",
        "description": "Free-text case-insensitive regex applied ONLY to the overview panel at top. Per-family panels ignore this so you can browse a family while filtering the overview.",
        "current": {
          "text": "",
          "value": "",
          "selected": false
        },
        "query": "",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "All Temperatures (overview — use Search box to filter)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "All Temperatures °C (filtered by Search regex)",
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "max": 110,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 380,
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-prometheus"
          },
          "expr": "redfish_sensor_celsius{cluster=~\"$cluster\", bmc=~\"$node\", sensor=~\"(?i).*${search:raw}.*\"}",
          "legendFormat": "{{chassis}}/{{sensor}}",
          "refId": "A"
        }
      ]
    },
