          "mode": "multi"
        }
      },
      "title": "Kubelet Operation Latency p99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(operation_type, le)(rate(kubelet_runtime_operations_duration_seconds_bucket{job=\"kubelet\",node=~\"$node\"}[5m])))",
