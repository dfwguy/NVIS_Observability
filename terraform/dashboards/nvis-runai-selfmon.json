      "id": 9902,
      "options": {
        "content": "<div style=\"display:flex;align-items:center;height:100%;\"><a href=\"/d/nvis-k8s-user-mgmt\" style=\"display:inline-flex;align-items:center;gap:8px;padding:6px 16px;background:linear-gradient(135deg,#1a2e1a,#16331e);color:#73bf69;border:1px solid #73bf69;border-radius:6px;text-decoration:none;font-size:13px;font-weight:600;box-shadow:0 0 8px rgba(115,191,105,0.3);\">&#9096; K8s Dashboard</a></div>",
        "mode": "html"
      },
