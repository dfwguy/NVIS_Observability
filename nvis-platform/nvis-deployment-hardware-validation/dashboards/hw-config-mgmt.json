        "w": 3,
        "x": 0,
        "y": 17
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "noValue": "N/A",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-prometheus"
          },
          "expr": "sum(redfish_up{cluster=~\"$cluster\", bmc=~\"$node\"}) or vector(0)",
          "instant": true,
          "legendFormat": "{{serial}}",
          "refId": "A"
