{
  "uid": "nvis-cmdaemon-cm",
  "title": "NVIS CMDaemon & ClusterMinder",
  "tags": [
    "nvis",
    "bcm",
    "cmdaemon",
    "clusterminder"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-victoriametrics"
        },
        "query": {
          "query": "label_values(bcm_node_up, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "sort": 1,
        "current": {}
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": {
          "type": "prometheus",
          "uid": "nvis-victoriametrics"
        },
        "query": {
          "query": "label_values(bcm_node_up{cluster=\"$cluster\"}, hostname)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "id": 9900,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;height:100%;\"><a href=\"/d/nvis-demo-home\" style=\"display:inline-flex;align-items:center;gap:8px;padding:6px 16px;background:linear-gradient(135deg,#1a1a2e,#16213e);color:#00d4ff;border:1px solid #00d4ff;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;letter-spacing:0.5px;box-shadow:0 0 8px rgba(0,212,255,0.3);transition:all 0.2s;\" onmouseover=\"this.style.boxShadow='0 0 16px rgba(0,212,255,0.6)'\" onmouseout=\"this.style.boxShadow='0 0 8px rgba(0,212,255,0.3)'\">&#127968; NVIS Home</a></div>",
        "justifyContent": "center",
        "alignItems": "center"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "CMDaemon Exporter Status",
      "description": "Whether the CMDaemon exporter can reach BCM",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 3,
        "y": 0
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "cmdaemon_up",
          "legendFormat": "CMDaemon",
          "refId": "A"
        }
      ]
    },
