      "options": {
        "content": "<div style=\"display:flex;align-items:center;height:100%;padding:0 16px;\"><span style=\"font-size:22px;font-weight:700;color:#00d4ff;letter-spacing:1px;\">&#9096; Kubernetes &amp; RunAI \u2014 Infrastructure &amp; User Management</span><span style=\"margin-left:16px;font-size:13px;color:#aaa;\">Kubelet \u00b7 API Server \u00b7 Controller Manager \u00b7 Nodes \u00b7 Namespaces \u00b7 Workloads \u00b7 Projects</span></div>",
