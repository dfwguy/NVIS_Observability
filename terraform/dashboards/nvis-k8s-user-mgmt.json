    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 100,
      "panels": [],
      "title": "\ud83d\udcca Cluster Health At-a-Glance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "K8s nodes in Ready state",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#2eb56e",
            "mode": "fixed"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 101,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "Nodes Ready",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_node_status_condition{cluster=~\"$cluster\",condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Ready",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total RunAI project namespaces",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#5794f2",
            "mode": "fixed"
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "id": 102,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "RunAI Projects",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_namespace_created{cluster=~\"$cluster\",namespace=~\"runai-.*\"})",
          "legendFormat": "Projects",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Currently running RunAI workloads",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#73bf69",
            "mode": "fixed"
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "id": 103,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "Running Workloads",
      "type": "stat",
      "targets": [
        {
          "expr": "count(runai_workload_info_enriched{cluster=~\"$cluster\",phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Pending RunAI workloads",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#f2cc0c",
            "mode": "fixed"
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "id": 104,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "Pending Workloads",
      "type": "stat",
      "targets": [
        {
          "expr": "count(runai_workload_info_enriched{cluster=~\"$cluster\",phase=\"Pending\"})",
          "legendFormat": "Pending",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "API server requests per second (all verbs)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#b877d9",
            "mode": "fixed"
          },
          "unit": "reqps",
          "decimals": 1
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "id": 105,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "API Server RPS",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(apiserver_request_total{job=\"apiserver\"}[5m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total pods running on compute nodes (node001-004)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#37872d",
            "mode": "fixed"
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "id": 106,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "Running Pods (Compute)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kubelet_running_pods{job=\"kubelet\",node=~\"node.*\"})",
          "legendFormat": "Pods",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 200,
      "panels": [],
      "title": "\ud83d\udc64 RunAI User Management & Projects",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "All RunAI projects (namespaces) with creation timestamps. Value = unix epoch of namespace creation.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Created (epoch)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 7
      },
      "id": 201,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Created (epoch)"
          }
        ]
      },
      "title": "RunAI Projects \u2014 Creation Timeline",
      "type": "table",
      "targets": [
        {
          "expr": "kube_namespace_created{cluster=~\"$cluster\",namespace=~\"runai-.*\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace": "Project",
              "Value": "Created (epoch)"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "job": true,
              "instance": true,
              "cluster_id": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Active workloads grouped by user and project",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "User"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Running": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "Pending": {
                        "color": "yellow",
                        "index": 1
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "Failed": {
                        "color": "red",
                        "index": 2
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 7
      },
      "id": 202,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "title": "Active Workloads by User & Project",
      "type": "table",
      "targets": [
        {
          "expr": "runai_workload_info_enriched{cluster=~\"$cluster\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "user": "User",
              "project": "Project",
              "workload_type": "Type",
              "phase": "Phase",
              "detailed_status": "Status",
              "nodepool": "Nodepool",
              "is_gpu": "GPU?"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "job": true,
              "instance": true,
              "Value": true,
              "cluster_id": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GPU allocation per project (guaranteed + requested)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 203,
      "options": {
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "xTickLabelRotation": 0
      },
      "title": "GPU Allocation by Project",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by(project)(runai_project_guaranteed_gpus{cluster=~\"$cluster\"})",
          "legendFormat": "Guaranteed \u2014 {{project}}",
          "refId": "A"
        },
        {
          "expr": "sum by(project)(runai_queue_allocated_gpus{cluster=~\"$cluster\"})",
          "legendFormat": "Allocated \u2014 {{project}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Workload count over time by phase",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 204,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Workload Count Over Time (by Phase)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "count by(phase)(runai_workload_info_enriched{cluster=~\"$cluster\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
